# ARM64 package admission and staged-only thinning. Never call thinning on caches.
# Keep symlink validation separate so owners can reject inputs before copying.
function(rai_check_payload_links root)
   if(NOT IS_DIRECTORY "${root}" OR IS_SYMLINK "${root}")
      message(FATAL_ERROR "Missing or symlinked package payload: ${root}")
   endif()
   get_filename_component(realRoot "${root}" REALPATH)
   file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE "${root}/*")
   foreach(entry ${entries})
      if(IS_SYMLINK "${entry}")
         if(NOT EXISTS "${entry}")
            message(FATAL_ERROR "Dangling package symlink: ${entry}")
         endif()
         get_filename_component(target "${entry}" REALPATH)
         string(FIND "${target}" "${realRoot}/" prefix)
         if(NOT target STREQUAL realRoot AND NOT prefix EQUAL 0)
            message(FATAL_ERROR "Escaping package symlink: ${entry}")
         endif()
      endif()
   endforeach()
endfunction()

function(rai_require_disjoint stage input)
   get_filename_component(stageReal "${stage}" REALPATH)
   get_filename_component(inputReal "${input}" REALPATH)
   string(FIND "${stageReal}/" "${inputReal}/" stageInside)
   string(FIND "${inputReal}/" "${stageReal}/" inputInside)
   if(stageInside EQUAL 0 OR inputInside EQUAL 0)
      message(FATAL_ERROR "Staged output and producer input overlap: ${stage}: ${input}")
   endif()
endfunction()

# Architecture policy: paired paths keep their native CPU; shared files need both.
# These admission functions never modify producer inputs or thin shared resources.
function(rai_require_native path required executable)
   if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
      message(FATAL_ERROR "Required native file invalid: ${path}")
   endif()
   if(executable)
      execute_process(COMMAND /bin/test -x "${path}" RESULT_VARIABLE result)
      if(NOT result EQUAL 0)
         message(FATAL_ERROR "Required native executable invalid: ${path}")
      endif()
   endif()
   execute_process(COMMAND /usr/bin/file -b "${path}" OUTPUT_VARIABLE kind RESULT_VARIABLE result)
   if(NOT result EQUAL 0 OR NOT kind MATCHES "Mach-O")
      message(FATAL_ERROR "Required native Mach-O invalid: ${path}")
   endif()
   execute_process(COMMAND /usr/bin/lipo -archs "${path}"
      OUTPUT_VARIABLE archs OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
   if(NOT result EQUAL 0)
      message(FATAL_ERROR "Cannot inspect native slices: ${path}")
   endif()
   foreach(cpu ${required})
      if(NOT archs MATCHES "(^| )${cpu}( |$)")
         message(FATAL_ERROR "Required ${cpu} slice missing: ${path}: ${archs}")
      endif()
   endforeach()
endfunction()

function(rai_native_payload root required)
   rai_check_payload_links("${root}")
   file(GLOB_RECURSE entries LIST_DIRECTORIES FALSE "${root}/*")
   set(nativeCount 0)
   foreach(entry ${entries})
      if(IS_SYMLINK "${entry}")
         continue()
      endif()
      file(READ "${entry}" magic LIMIT 4 HEX)
      if(NOT magic MATCHES "^(feedface|cefaedfe|feedfacf|cffaedfe|cafebabe|bebafeca|cafebabf|bfbafeca)$")
         continue()
      endif()
      execute_process(COMMAND /usr/bin/file -b "${entry}" OUTPUT_VARIABLE kind RESULT_VARIABLE result)
      if(result EQUAL 0 AND magic STREQUAL "cafebabe" AND kind MATCHES "compiled Java class")
         continue()
      endif()
      set(cpus "${required}")
      if(required STREQUAL "dispatched")
         file(RELATIVE_PATH relative "${root}" "${entry}")
         if(relative MATCHES "(^|/)(aarch64|arm64|darwin-arm64)(/|$)")
            set(cpus arm64)
         elseif(relative MATCHES "(^|/)(x86_64|x64|darwin-x64)(/|$)")
            set(cpus x86_64)
         else()
            set(cpus "x86_64;arm64")
         endif()
      endif()
      rai_require_native("${entry}" "${cpus}" FALSE)
      math(EXPR nativeCount "${nativeCount}+1")
   endforeach()
   if(nativeCount EQUAL 0)
      message(FATAL_ERROR "Empty native payload scan: ${root}")
   endif()
endfunction()

# Required pinned dispatch roles; do not require every optional helper to have
# a same-name peer (the retained Intel Quarto does not include typst-gather).
function(rai_check_pandoc_pair root)
   rai_check_payload_links("${root}")
   rai_require_native("${root}/aarch64/pandoc" arm64 TRUE)
   rai_require_native("${root}/x86_64/pandoc" x86_64 TRUE)
   rai_native_payload("${root}" dispatched)
endfunction()
function(rai_check_quarto_pair root)
   rai_check_pandoc_pair("${root}")
   foreach(pair "aarch64;arm64" "x86_64;x86_64")
      list(GET pair 0 directory)
      list(GET pair 1 cpu)
      foreach(helper deno typst esbuild dart-sass/src/dart)
         rai_require_native("${root}/${directory}/${helper}" "${cpu}" TRUE)
      endforeach()
      rai_require_native("${root}/${directory}/deno_dom/libplugin.dylib" "${cpu}" FALSE)
   endforeach()
endfunction()
function(rai_check_copilot_pair root)
   rai_check_payload_links("${root}")
   foreach(cpu arm64 x64)
      set(arch "${cpu}")
      if(cpu STREQUAL "x64")
         set(arch x86_64)
      endif()
      rai_require_native("${root}/bin/darwin/${cpu}/rg" "${arch}" TRUE)
      foreach(module keytar watcher kerberos copilot-tokenizer vscode-policy-watcher)
         rai_require_native("${root}/compiled/darwin/${cpu}/${module}.node" "${arch}" FALSE)
      endforeach()
      rai_require_native("${root}/node_modules/@github/copilot/sdk/prebuilds/darwin-${cpu}/spawn-helper" "${arch}" TRUE)
      foreach(module pty.node keytar.node cli-native.node runtime.node computer.node)
         rai_require_native("${root}/node_modules/@github/copilot/sdk/prebuilds/darwin-${cpu}/${module}" "${arch}" FALSE)
      endforeach()
   endforeach()
   rai_native_payload("${root}" dispatched)
endfunction()

# Copy only from the explicitly admitted alternate producer, never primary bytes.
function(rai_merge_native_pair stage primary alternate)
   rai_check_payload_links("${stage}")
   get_filename_component(stageReal "${stage}" REALPATH)
   foreach(input "${primary}" "${alternate}")
      get_filename_component(real "${input}" REALPATH)
      string(FIND "${real}" "${stageReal}/" prefix)
      if(NOT prefix EQUAL 0)
         message(FATAL_ERROR "Native merge is staged-only: ${input}")
      endif()
   endforeach()
   rai_require_native("${primary}" x86_64 TRUE)
   rai_require_native("${alternate}" arm64 TRUE)
   if(EXISTS "${primary}.rai-universal" OR IS_SYMLINK "${primary}.rai-universal")
      message(FATAL_ERROR "Native merge temporary output already exists: ${primary}")
   endif()
   execute_process(COMMAND /usr/bin/lipo -create "${primary}" "${alternate}" -output "${primary}.rai-universal"
      RESULT_VARIABLE result)
   if(NOT result EQUAL 0)
      message(FATAL_ERROR "Shared native component merge failed: ${primary}")
   endif()
   rai_require_native("${primary}.rai-universal" "x86_64;arm64" TRUE)
   file(RENAME "${primary}.rai-universal" "${primary}")
endfunction()

function(rai_install_arm_alternate bindir session node)
   rai_check_payload_links("${bindir}")
   rai_require_disjoint("${bindir}" "${session}")
   rai_require_disjoint("${bindir}" "${node}")
   rai_require_native("${bindir}/rsession" x86_64 TRUE)
   rai_require_native("${session}" arm64 TRUE)
   rai_check_payload_links("${node}")
   rai_require_native("${node}/bin/node" arm64 TRUE)
   get_filename_component(primary "${bindir}/rsession" REALPATH)
   get_filename_component(alternate "${session}" REALPATH)
   if(primary STREQUAL alternate)
      message(FATAL_ERROR "Distinct primary and alternate session inputs required")
   endif()
   configure_file("${session}" "${bindir}/rsession-arm64" COPYONLY)
   file(COPY "${node}/" DESTINATION "${bindir}/node-arm64" USE_SOURCE_PERMISSIONS)
   rai_require_native("${bindir}/rsession-arm64" arm64 TRUE)
   rai_native_payload("${bindir}/node-arm64" arm64)
endfunction()

# Retained thin nonrelease helper and its generic regression coverage.
function(rai_arm64_payload root thin)
   rai_check_payload_links("${root}")
   file(GLOB_RECURSE entries LIST_DIRECTORIES FALSE "${root}/*")
   set(nativeCount 0)
   foreach(entry ${entries})
      if(IS_SYMLINK "${entry}")
         continue()
      endif()
      file(READ "${entry}" magic LIMIT 4 HEX)
      if(NOT magic MATCHES "^(feedface|cefaedfe|feedfacf|cffaedfe|cafebabe|bebafeca|cafebabf|bfbafeca)$")
         continue()
      endif()
      execute_process(COMMAND /usr/bin/file -b "${entry}" OUTPUT_VARIABLE kind RESULT_VARIABLE result)
      if(NOT result EQUAL 0)
         message(FATAL_ERROR "Cannot classify package native file: ${entry}")
      endif()
      if(magic STREQUAL "cafebabe" AND kind MATCHES "compiled Java class")
         continue()
      endif()
      if(NOT kind MATCHES "Mach-O")
         message(FATAL_ERROR "Malformed package Mach-O: ${entry}")
      endif()
      execute_process(COMMAND /usr/bin/lipo -archs "${entry}"
                      OUTPUT_VARIABLE archs OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
      if(NOT result EQUAL 0 OR NOT archs MATCHES "(^| )arm64( |$)")
         message(FATAL_ERROR "ARM64 slice missing: ${entry}: ${archs}")
      endif()
      if(NOT archs STREQUAL "arm64")
         if(NOT thin)
            message(FATAL_ERROR "Non-ARM64 package slices: ${entry}: ${archs}")
         endif()
         execute_process(COMMAND /usr/bin/lipo "${entry}" -thin arm64 -output "${entry}.rai-arm64"
                         RESULT_VARIABLE result)
         if(NOT result EQUAL 0)
            message(FATAL_ERROR "ARM64 thinning failed: ${entry}")
         endif()
         file(RENAME "${entry}.rai-arm64" "${entry}")
         execute_process(COMMAND /usr/bin/lipo -archs "${entry}"
                         OUTPUT_VARIABLE archs OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
         if(NOT result EQUAL 0 OR NOT archs STREQUAL "arm64")
            message(FATAL_ERROR "ARM64 thinning readback failed: ${entry}")
         endif()
      endif()
      math(EXPR nativeCount "${nativeCount}+1")
   endforeach()
   if(nativeCount EQUAL 0)
      message(FATAL_ERROR "Empty ARM64 native payload scan: ${root}")
   endif()
   message(STATUS "ARM64 package payload verified: ${root} (${nativeCount} native files)")
endfunction()
