# Optional checksum-pinned arm64 Pandoc replacement. Preserve Quarto and its
# x86 payload; never rewrite an upstream binary's deployment load commands.
cmake_minimum_required(VERSION 3.6.3)
set(RAI_PACKAGE_PANDOC_BINARY "@RAI_PACKAGE_PANDOC_BINARY@" CACHE FILEPATH "Pinned deployment-compatible Pandoc")
set(RAI_PACKAGE_PANDOC_SHA256 "@RAI_PACKAGE_PANDOC_SHA256@" CACHE STRING "Expected binary SHA256")
if(RAI_PACKAGE_PANDOC_BINARY MATCHES "^@" OR RAI_PACKAGE_PANDOC_BINARY STREQUAL "")
   return()
endif()
if(NOT EXISTS "${RAI_PACKAGE_PANDOC_BINARY}" OR IS_SYMLINK "${RAI_PACKAGE_PANDOC_BINARY}")
   message(FATAL_ERROR "Pinned Pandoc must be an existing regular binary")
endif()
string(LENGTH "${RAI_PACKAGE_PANDOC_SHA256}" hash_length)
if(NOT hash_length EQUAL 64 OR NOT RAI_PACKAGE_PANDOC_SHA256 MATCHES "^[0-9a-f]+$")
   message(FATAL_ERROR "Pinned Pandoc requires its exact SHA256")
endif()
file(SHA256 "${RAI_PACKAGE_PANDOC_BINARY}" actual_hash)
if(NOT actual_hash STREQUAL RAI_PACKAGE_PANDOC_SHA256)
   message(FATAL_ERROR "Pinned Pandoc SHA256 mismatch")
endif()
execute_process(COMMAND "${RAI_PACKAGE_PANDOC_BINARY}" --version RESULT_VARIABLE status OUTPUT_VARIABLE version)
if(NOT status EQUAL 0 OR NOT version MATCHES "^pandoc 3[.]8[.]3\nFeatures: [+]server [+]lua\n")
   message(FATAL_ERROR "Pinned Pandoc must retain 3.8.3, server and Lua")
endif()
execute_process(COMMAND /usr/bin/lipo -archs "${RAI_PACKAGE_PANDOC_BINARY}" RESULT_VARIABLE status OUTPUT_VARIABLE arch OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT status EQUAL 0 OR NOT arch STREQUAL "arm64")
   message(FATAL_ERROR "Pinned Pandoc must be arm64")
endif()
execute_process(COMMAND /usr/bin/otool -l "${RAI_PACKAGE_PANDOC_BINARY}" RESULT_VARIABLE status OUTPUT_VARIABLE metadata)
if(NOT status EQUAL 0 OR NOT metadata MATCHES "minos 12[.]0[\r\n]")
   message(FATAL_ERROR "Pinned Pandoc must be a genuine macOS12-target build")
endif()
set(destination "${CMAKE_INSTALL_PREFIX}/RAI-Studio.app/Contents/Resources/app/quarto/bin/tools/aarch64/pandoc")
if(NOT EXISTS "${destination}")
   message(FATAL_ERROR "Quarto arm64 Pandoc target missing")
endif()
configure_file("${RAI_PACKAGE_PANDOC_BINARY}" "${destination}" COPYONLY)
file(SHA256 "${destination}" packaged_hash)
if(NOT packaged_hash STREQUAL RAI_PACKAGE_PANDOC_SHA256)
   message(FATAL_ERROR "Packaged Pandoc identity mismatch")
endif()
message(STATUS "Bundled checksum-pinned Pandoc3.8.3 arm64/macOS12 with server and Lua")
