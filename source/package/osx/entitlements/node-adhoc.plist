<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- Required for Node's JIT (V8). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- The bundled node binary dlopen()s the RAI bridge's native addons
       (e.g. node-pty's prebuilt pty.node), which are ad-hoc signed
       separately from node itself and so do not share a Team ID with it.
       Without this, hardened runtime's library validation rejects the
       load with "different Team IDs" even though both files are part of
       the same app bundle. Same rationale as rsession-adhoc.plist. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

</dict>
</plist>
